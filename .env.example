# Copy this file to .env outside the repository or inject these values into your deployment environment.
# Database Configuration (MySQL)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# MySQL Root Password (para Docker)
MYSQL_ROOT_PASSWORD=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=4000
NODE_ENV=production

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# RAG Microservice
START_RAG=false
OLLAMA_HOST=host.docker.internal

# Ngrok Configuration (opcional)
NGROK_AUTHTOKEN=
