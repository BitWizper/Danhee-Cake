# Copy this file to .env outside the repository or inject these values into your deployment environment.

# ============================================================
# SETUP AUTOMÁTICO PARA DESARROLLO LOCAL
# ============================================================
# Para configurar tu entorno de desarrollo local automáticamente:
# 1. Copia este archivo a .env: cp .env.example .env
# 2. Ejecuta: node setup-dev.js
# Esto generará automáticamente JWT_SECRET y REFRESH_TOKEN_SECRET seguros
#
# Para producción: Configura estas variables directamente en tu proveedor de hosting
# (Clever Cloud, Vercel, Railway, etc.) como variables de entorno

# ============================================================
# Database Configuration (MySQL)
# ============================================================

# Clever Cloud MySQL Configuration (prioridad si está configurado)
# Si DB_HOST contiene "clever-cloud", se intentará conectar a Clever Cloud primero.
# Si falla la conexión, se hará fallback automático a la base de datos local.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Forzar uso de base de datos local (ignora Clever Cloud)
# DB_USE_LOCAL_DB=true

# Base de datos local (fallback o uso directo)
LOCAL_DB_NAME=danhee_db
LOCAL_DB_USER=usuario
LOCAL_DB_PASSWORD=password

# MySQL Root Password (para Docker)
MYSQL_ROOT_PASSWORD=

# JWT Configuration
# Estos secretos se generarán automáticamente ejecutando: node setup-dev.js
JWT_SECRET=change-me-in-production
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Server Configuration
PORT=4000
NODE_ENV=production

# CORS Configuration
# FRONTEND_URL: URL del frontend en Vercel para permitir peticiones CORS en el backend
# En desarrollo: http://localhost:5173
# En producción: https://danhee-cake.vercel.app
FRONTEND_URL=https://danhee-cake.vercel.app

# RAG Microservice
START_RAG=true
OLLAMA_HOST=host.docker.internal
RAG_SERVICE_URL=http://localhost:5001
RAG_SERVICE_SECRET=your-rag-service-secret-here
RAG_PORT=5001
CHROMA_HOST=http://localhost:8000

