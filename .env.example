# Copy this file to .env outside the repository or inject these values into your deployment environment.

# ============================================================
# Frontend Configuration (Vercel)
# ============================================================

# VITE_BASE_URL: URL del backend para peticiones API desde el frontend
# En desarrollo: '' (vacío, usa proxy)
# En producción: URL de tu backend en Clever Cloud o Cloudflare Tunnel
# Ejemplo: https://highlighted-cartoons-bacterial-applicants.trycloudflare.com
VITE_BASE_URL=https://highlighted-cartoons-bacterial-applicants.trycloudflare.com

# ============================================================
# Database Configuration (MySQL)
# ============================================================

# Clever Cloud MySQL Configuration (prioridad si está configurado)
# Si DB_HOST contiene "clever-cloud", se intentará conectar a Clever Cloud primero.
# Si falla la conexión, se hará fallback automático a la base de datos local.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Forzar uso de base de datos local (ignora Clever Cloud)
# DB_USE_LOCAL_DB=true

# Base de datos local (fallback o uso directo)
LOCAL_DB_NAME=danhee_db
LOCAL_DB_USER=usuario
LOCAL_DB_PASSWORD=password

# MySQL Root Password (para Docker)
MYSQL_ROOT_PASSWORD=

# JWT Configuration
JWT_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Server Configuration
PORT=4000
NODE_ENV=production

# CORS Configuration
# FRONTEND_URL: URL del frontend en Vercel para permitir peticiones CORS en el backend
# En desarrollo: http://localhost:5173
# En producción: https://danhee-cake.vercel.app
FRONTEND_URL=https://danhee-cake.vercel.app

# RAG Microservice
START_RAG=true
OLLAMA_HOST=host.docker.internal

